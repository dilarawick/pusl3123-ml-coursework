 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# Exercise 3: Regularisation and Generalisation (CNN)\n\nIn this notebook we will evaluate regularisation techniques on the CNN from Exercise 2.\n\n## Sections\n1. **Baseline CNN** – same architecture as Exercise 2 (no regularisation).\n2. **Dropout** – add `nn.Dropout` after the second convolutional block.\n3. **Data Augmentation** – apply random rotations / translations via `torchvision.transforms`.\n4. **Training & Evaluation** – identical training settings for all three experiments.\n5. **Results** – compile train / test accuracies and loss curves into a table/graph.\n\n*The cells below provide the skeleton; fill in the specifics and run the experiments.*"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["import torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision\nimport torchvision.transforms as transforms\nimport matplotlib.pyplot as plt\n%matplotlib inline"],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["# Common data transforms (baseline)\ntransform_base = transforms.Compose([\n    transforms.ToTensor(),\n    transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))\n])\n\n# Augmentation transforms (for augmentation experiment)\ntransform_aug = transforms.Compose([\n    transforms.RandomHorizontalFlip(),\n    transforms.RandomCrop(32, padding=4),\n    transforms.ToTensor(),\n    transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))\n])\n\ntrain_set_base = torchvision.datasets.CIFAR10(root='data', train=True, download=True, transform=transform_base)\ntrain_set_aug = torchvision.datasets.CIFAR10(root='data', train=True, download=True, transform=transform_aug)\ntest_set = torchvision.datasets.CIFAR10(root='data', train=False, download=True, transform=transform_base)\n\ntrain_loader_base = torch.utils.data.DataLoader(train_set_base, batch_size=128, shuffle=True, num_workers=2)\ntrain_loader_aug = torch.utils.data.DataLoader(train_set_aug, batch_size=128, shuffle=True, num_workers=2)\ntest_loader = torch.utils.data.DataLoader(test_set, batch_size=100, shuffle=False, num_workers=2)\n"],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["# Baseline CNN (same as Exercise 2)\nclass CNNBase(nn.Module):\n    def __init__(self):\n        super(CNNBase, self).__init__()\n        self.conv1 = nn.Conv2d(3, 32, 3, padding=1)\n        self.conv2 = nn.Conv2d(32, 64, 3, padding=1)\n        self.conv3 = nn.Conv2d(64, 128, 3, padding=1)\n        self.pool = nn.MaxPool2d(2, 2)\n        self.relu = nn.ReLU()\n        self.fc = nn.Linear(128 * 4 * 4, 10)\n\n    def forward(self, x):\n        x = self.relu(self.conv1(x))\n        x = self.pool(x)\n        x = self.relu(self.conv2(x))\n        x = self.pool(x)\n        x = self.relu(self.conv3(x))\n        x = self.pool(x)\n        x = x.view(x.size(0), -1)\n        x = self.fc(x)\n        return x\n"],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["# CNN with Dropout (insert dropout after second conv block)\nclass CNNDropout(nn.Module):\n    def __init__(self, p=0.5):\n        super(CNNDropout, self).__init__()\n        self.conv1 = nn.Conv2d(3, 32, 3, padding=1)\n        self.conv2 = nn.Conv2d(32, 64, 3, padding=1)\n        self.conv3 = nn.Conv2d(64, 128, 3, padding=1)\n        self.pool = nn.MaxPool2d(2, 2)\n        self.relu = nn.ReLU()\n        self.dropout = nn.Dropout(p)\n        self.fc = nn.Linear(128 * 4 * 4, 10)\n\n    def forward(self, x):\n        x = self.relu(self.conv1(x))\n        x = self.pool(x)\n        x = self.relu(self.conv2(x))\n        x = self.dropout(x)\n        x = self.pool(x)\n        x = self.relu(self.conv3(x))\n        x = self.pool(x)\n        x = x.view(x.size(0), -1)\n        x = self.fc(x)\n        return x\n"],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Training helper (shared)\nThe following function runs one training loop and returns loss history and final accuracy. Fill in the hyper‑parameters as needed."]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["def train_model(model, train_loader, test_loader, epochs=20, lr=0.001):\n    criterion = nn.CrossEntropyLoss()\n    optimizer = optim.Adam(model.parameters(), lr=lr)\n    train_losses, val_losses = [], []\n    for epoch in range(epochs):\n        model.train()\n        running = 0.0\n        for inputs, labels in train_loader:\n            optimizer.zero_grad()\n            outputs = model(inputs)\n            loss = criterion(outputs, labels)\n            loss.backward()\n            optimizer.step()\n            running += loss.item() * inputs.size(0)\n        epoch_loss = running / len(train_loader.dataset)\n        train_losses.append(epoch_loss)\n        # validation on test set (proxy)\n        model.eval()\n        val_running = 0.0\n        correct, total = 0, 0\n        with torch.no_grad():\n            for inputs, labels in test_loader:\n                outputs = model(inputs)\n                loss = criterion(outputs, labels)\n                val_running += loss.item() * inputs.size(0)\n                _, pred = torch.max(outputs, 1)\n                total += labels.size(0)\n                correct += (pred == labels).sum().item()\n        val_losses.append(val_running / len(test_loader.dataset))\n        print(f'Epoch {epoch+1}/{epochs}, Train {epoch_loss:.4f}, Val {val_losses[-1]:.4f}, Test Acc {100*correct/total:.2f}%')\n    return train_losses, val_losses, 100*correct/total\n"],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 1️⃣ Baseline CNN (no regularisation)\nRun the training using `train_loader_base` and `CNNBase()`."]
