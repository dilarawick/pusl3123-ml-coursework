  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# Exercise 4: Effect of Model Width and Depth (CNN)\n\nInvestigate how changing the number of kernels (width) and number of convolutional blocks (depth) impacts CIFAR‑10 classification performance and computational cost.\n\n## Outline\n1. Define a parameterised CNN class where `width` sets the number of filters per layer and `depth` controls how many conv‑pool blocks are stacked.\n2. Create three width configurations (e.g., 32, 64, 128) and three depth configurations (e.g., 2, 3, 4).\n3. Train each model with identical hyper‑parameters (learning rate, epochs, batch size).\n4. Record validation accuracy, training loss, and total trainable parameters.\n5. Visualise results:\n   - Accuracy vs. width (fixed depth)\n   - Accuracy vs. depth (fixed width)\n   - Parameter count vs. accuracy\n\n*Fill in the sections below and run the experiments.*"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["import torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision\nimport torchvision.transforms as transforms\nimport matplotlib.pyplot as plt\n%matplotlib inline"],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["# Data transforms (same as previous exercises)\ntransform = transforms.Compose([\n    transforms.ToTensor(),\n    transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))\n])\n\ntrain_set = torchvision.datasets.CIFAR10(root='data', train=True, download=True, transform=transform)\ntest_set = torchvision.datasets.CIFAR10(root='data', train=False, download=True, transform=transform)\n\ntrain_loader = torch.utils.data.DataLoader(train_set, batch_size=128, shuffle=True, num_workers=2)\ntest_loader = torch.utils.data.DataLoader(test_set, batch_size=100, shuffle=False, num_workers=2)\n"],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["# Parameterised CNN\nclass CNNVariable(nn.Module):\n    def __init__(self, width=32, depth=3):\n        super(CNNVariable, self).__init__()\n        layers = []\n        in_channels = 3\n        for d in range(depth):\n            out_channels = width * (2 ** d)  # double filters each block (optional)\n            layers.append(nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1))\n            layers.append(nn.ReLU())\n            layers.append(nn.MaxPool2d(2, 2))\n            in_channels = out_channels\n        self.features = nn.Sequential(*layers)\n        # Compute the feature map size after depth pooling (32 -> 32/(2^depth))\n        final_spatial = 32 // (2 ** depth)\n        self.classifier = nn.Linear(in_channels * final_spatial * final_spatial, 10)\n\n    def forward(self, x):\n        x = self.features(x)\n        x = x.view(x.size(0), -1)\n        x = self.classifier(x)\n        return x\n"],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": ["def train_and_evaluate(width, depth, epochs=20, lr=0.001):\n    model = CNNVariable(width=width, depth=depth)\n    criterion = nn.CrossEntropyLoss()\n    optimizer = optim.Adam(model.parameters(), lr=lr)\n    train_losses, val_losses = [], []\n    for epoch in range(epochs):\n        model.train()\n        running = 0.0\n        for inputs, labels in train_loader:\n            optimizer.zero_grad()\n            outputs = model(inputs)\n            loss = criterion(outputs, labels)\n            loss.backward()\n            optimizer.step()\n            running += loss.item() * inputs.size(0)\n        epoch_loss = running / len(train_loader.dataset)\n        train_losses.append(epoch_loss)\n        # validation on test set\n        model.eval()\n        val_running = 0.0\n        correct, total = 0, 0\n        with torch.no_grad():\n            for inputs, labels in test_loader:\n                outputs = model(inputs)\n                loss = criterion(outputs, labels)\n                val_running += loss.item() * inputs.size(0)\n                _, pred = torch.max(outputs, 1)\n                total += labels.size(0)\n                correct += (pred == labels).sum().item()\n        val_losses.append(val_running / len(test_loader.dataset))\n        print(f'Width {width}, Depth {depth}, Epoch {epoch+1}/{epochs}, Train {epoch_loss:.4f}, Val {val_losses[-1]:.4f}, Test Acc {100*correct/total:.2f}%')\n    # Parameter count\n    params = sum(p.numel() for p in model.parameters())\n    test_acc = 100 * correct / total\n    return train_losses, val_losses, test_acc, params\n"],
   "execution_count": null,
   "outputs": []
  },
  {
